/**
 * REPORT ENGINE - Especificação Técnica
 * Service: svc-tax-engine
 * Responsável por: Parser de dados Verot, cálculos tributários, geração de relatórios
 */

// ============================================================================
// 1. FORMATO DE ENTRADA (Excel exportado do Verot)
// ============================================================================
// 
// O Verot (SpedAdvisor) exporta relatórios em formato Excel (.xlsx, .xls, .csv)
// Este arquivo Excel é importado via upload e parseado para o formato VerotInputData
// 
// Formatos suportados:
// - .xlsx (Excel 2007+)
// - .xls (Excel 97-2003)
// - .csv (valores separados por vírgula)
//
// A interface VerotInputData abaixo representa o formato INTERNO após parsing do Excel

export interface VerotInputData {
  empresa: {
    cnpj: string;
    razaoSocial: string;
    periodo: {
      inicio: string; // ISO date
      fim: string;
    };
  };
  tributos: {
    pis: TributoDetalhes;
    cofins: TributoDetalhes;
    icms: TributoDetalhes;
    irpj: TributoDetalhes;
    csll: TributoDetalhes;
  };
  creditos: {
    identificados: CreditoItem[];
    potenciais: CreditoItem[];
  };
}

interface TributoDetalhes {
  valorPago: number;
  valorDevido: number;
  diferencaRecuperavel: number;
  percentualBase: number;
}

interface CreditoItem {
  tipo: string; // ex: "ICMS na base PIS/COFINS"
  descricao: string;
  valorEstimado: number;
  fundamentacaoLegal: string;
  complexidade: 'baixa' | 'media' | 'alta';
}

// ============================================================================
// 2. ALGORITMOS DE CÁLCULO
// ============================================================================

/**
 * Calcula o valor total recuperável somando todos os créditos identificados
 */
export function calcularValorRecuperavel(data: VerotInputData): number {
  const creditosIdentificados = data.creditos.identificados.reduce(
    (acc, item) => acc + item.valorEstimado,
    0
  );
  
  const diferencasTributarias = Object.values(data.tributos).reduce(
    (acc, tributo) => acc + tributo.diferencaRecuperavel,
    0
  );
  
  return creditosIdentificados + diferencasTributarias;
}

/**
 * Calcula o percentual de economia em relação ao total pago
 */
export function calcularPercentualEconomia(data: VerotInputData): number {
  const totalPago = Object.values(data.tributos).reduce(
    (acc, tributo) => acc + tributo.valorPago,
    0
  );
  
  const valorRecuperavel = calcularValorRecuperavel(data);
  
  return totalPago > 0 ? (valorRecuperavel / totalPago) * 100 : 0;
}

/**
 * Gera distribuição tributária para gráfico de pizza
 */
export function gerarDistribuicaoTributaria(data: VerotInputData): ChartData[] {
  return Object.entries(data.tributos).map(([nome, detalhes]) => ({
    name: nome.toUpperCase(),
    value: detalhes.valorPago,
    color: getTributoColor(nome),
  }));
}

function getTributoColor(tributo: string): string {
  const colors: Record<string, string> = {
    pis: '#00f2ff',      // Neon Blue (Brand)
    cofins: '#7c3aed',   // Purple
    icms: '#f59e0b',     // Amber
    irpj: '#10b981',     // Emerald
    csll: '#ef4444',     // Red
  };
  return colors[tributo] || '#6b7280';
}

// ============================================================================
// 3. FORMATO DE SAÍDA (Dashboard JSON)
// ============================================================================

export interface FirstAnalysisReport {
  metadata: {
    cnpj: string;
    razaoSocial: string;
    periodoAnalise: string;
    dataGeracao: string;
  };
  kpis: {
    valorRecuperavel: number;
    percentualEconomia: number;
    totalTributosPagos: number;
    quantidadeCreditosIdentificados: number;
  };
  charts: {
    distribuicaoTributaria: ChartData[];
    economiaEstimada: BarChartData[];
    timelineRecuperacao: TimelineData[];
  };
  creditos: {
    identificados: CreditoItem[];
    potenciais: CreditoItem[];
  };
  recomendacoes: string[];
}

interface ChartData {
  name: string;
  value: number;
  color: string;
}

interface BarChartData {
  categoria: string;
  valorPago: number;
  valorRecuperavel: number;
}

interface TimelineData {
  mes: string;
  acumulado: number;
}

// ============================================================================
// 4. LÓGICA DE NEGÓCIO (baseada em UltraTax.rag)
// ============================================================================

/**
 * Identifica oportunidades de crédito com base em regras fiscais
 * Fonte: Documentos Verot em UltraTax.rag
 */
export function identificarOportunidades(data: VerotInputData): CreditoItem[] {
  const oportunidades: CreditoItem[] = [];
  
  // Regra 1: ICMS na base de PIS/COFINS
  if (data.tributos.pis.valorPago > 0 && data.tributos.icms.valorPago > 0) {
    const valorEstimado = data.tributos.icms.valorPago * 0.0965; // 9.65% (PIS+COFINS)
    oportunidades.push({
      tipo: 'ICMS_BASE_PIS_COFINS',
      descricao: 'Exclusão do ICMS da base de cálculo de PIS/COFINS',
      valorEstimado,
      fundamentacaoLegal: 'RE 574.706 (Tema 69 STF)',
      complexidade: 'media',
    });
  }
  
  // Regra 2: Créditos de PIS/COFINS sobre insumos
  // (Adicionar mais regras conforme UltraTax.rag)
  
  return oportunidades;
}

