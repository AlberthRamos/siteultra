/**
 * Geração automática de sitemap.xml
 */
export const SitemapGenerator = `
import { Injectable } from '@nestjs/common';
import { BlogService } from '../blog/blog.service';
import * as fs from 'fs/promises';
import * as path from 'path';

@Injectable()
export class SitemapGeneratorService {
  constructor(private blogService: BlogService) {}

  async generateSitemap(): Promise<string> {
    const baseUrl = process.env.NEXT_PUBLIC_URL || 'https://ultrasystems.com.br';
    
    // Rotas estáticas
    const staticRoutes = [
      { loc: '/', priority: '1.0', changefreq: 'daily' },
      { loc: '/servicos/ultratax', priority: '0.9', changefreq: 'weekly' },
      { loc: '/servicos/ultrasecurity', priority: '0.9', changefreq: 'weekly' },
      { loc: '/sobre', priority: '0.8', changefreq: 'monthly' },
      { loc: '/contato', priority: '0.8', changefreq: 'monthly' },
      { loc: '/blog', priority: '0.9', changefreq: 'daily' },
    ];

    // Rotas dinâmicas (posts do blog)
    const posts = await this.blogService.getPublishedPosts();
    const postRoutes = posts.map(post => ({
      loc: \`/blog/\${post.slug}\`,
      priority: '0.7',
      changefreq: 'weekly',
      lastmod: post.updatedAt.toISOString().split('T')[0],
    }));

    const allRoutes = [...staticRoutes, ...postRoutes];

    // Gerar XML
    const xml = \`<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
\${allRoutes.map(route => \`
  <url>
    <loc>\${baseUrl}\${route.loc}</loc>
    <changefreq>\${route.changefreq}</changefreq>
    <priority>\${route.priority}</priority>
    \${route.lastmod ? \`<lastmod>\${route.lastmod}</lastmod>\` : ''}
  </url>\`).join('')}
</urlset>\`;

    // Salvar no diretório público do Next.js
    const sitemapPath = path.join(process.cwd(), '../web/public/sitemap.xml');
    await fs.writeFile(sitemapPath, xml, 'utf-8');

    console.log('[SEO] Sitemap gerado com sucesso');
    return xml;
  }

  /**
   * Faz ping nos motores de busca para notificar sobre atualização
   */
  async pingSearchEngines(): Promise<void> {
    const sitemapUrl = \`\${process.env.NEXT_PUBLIC_URL}/sitemap.xml\`;
    
    const searchEngines = [
      \`https://www.google.com/ping?sitemap=\${encodeURIComponent(sitemapUrl)}\`,
      \`https://www.bing.com/ping?sitemap=\${encodeURIComponent(sitemapUrl)}\`,
    ];

    for (const url of searchEngines) {
      try {
        await fetch(url);
        console.log(\`[SEO] Ping enviado para: \${url}\`);
      } catch (error) {
        console.error(\`[SEO] Erro ao fazer ping: \${url}\`, error);
      }
    }
  }
}
`;

