/**
 * Interface no CRM para Master Admin controlar a IA
 * apps/web/app/sys_8x9_core/ai-control/page.tsx
 */
export const AIControlUI = `
'use client';

import { useState } from 'react';
import { useMutation, useQuery } from '@tanstack/react-query';
import { Box, TextField, Button, Typography, Switch, FormControlLabel } from '@mui/material';

export default function AIControl() {
  const [systemPrompt, setSystemPrompt] = useState('');
  const [autoBlogEnabled, setAutoBlogEnabled] = useState(true);

  const { data: currentPrompt } = useQuery({
    queryKey: ['ai', 'system-prompt'],
    queryFn: () => fetch('/api/ai/system-prompt').then(r => r.json()),
  });

  const updatePromptMutation = useMutation({
    mutationFn: (prompt: string) =>
      fetch('/api/ai/system-prompt', {
        method: 'PUT',
        body: JSON.stringify({ prompt }),
      }),
  });

  const generatePostMutation = useMutation({
    mutationFn: () =>
      fetch('/api/ai/generate-post', { method: 'POST' }),
  });

  return (
    <Box>
      <Typography variant="h4">Controle da IA</Typography>
      
      <FormControlLabel
        control={
          <Switch
            checked={autoBlogEnabled}
            onChange={(e) => setAutoBlogEnabled(e.target.checked)}
          />
        }
        label="Auto-blogging Diário"
      />
      
      <TextField
        fullWidth
        multiline
        rows={10}
        label="System Prompt"
        value={systemPrompt || currentPrompt?.prompt}
        onChange={(e) => setSystemPrompt(e.target.value)}
        sx={{ mt: 2 }}
      />
      
      <Button
        variant="contained"
        onClick={() => updatePromptMutation.mutate(systemPrompt)}
        sx={{ mt: 2 }}
      >
        Salvar Prompt
      </Button>
      
      <Button
        variant="outlined"
        onClick={() => generatePostMutation.mutate()}
        sx={{ mt: 2, ml: 2 }}
      >
        Gerar Post Agora
      </Button>
    </Box>
  );
}
`;