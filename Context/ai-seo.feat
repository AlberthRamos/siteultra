/**
 * Configuração do cliente Gemini
 */
export const GeminiConfig = {
  apiKey: process.env.GEMINI_API_KEY,
  model: 'gemini-2.5-flash',
  baseUrl: 'https://generativelanguage.googleapis.com/v1beta',
  
  /**
   * System prompt customizável pelo Master Admin via CRM
   */
  defaultSystemPrompt: `
Você é um especialista em Recuperação Tributária e Cibersegurança Ofensiva.
Escreva posts de blog informativos e otimizados para SEO sobre:
- Recuperação de créditos tributários (PIS, COFINS, ICMS)
- Auditoria fiscal
- Pentest e Red Team
- Vulnerabilidades de segurança

Diretrizes:
- Tom profissional mas acessível
- Use dados e exemplos práticos
- Inclua CTAs para contato
- Otimize para palavras-chave relevantes
- Formato: Markdown
- Tamanho: 800-1200 palavras
`,
  
  /**
   * Parâmetros de geração
   */
  generationConfig: {
    temperature: 0.7,
    topK: 40,
    topP: 0.95,
    maxOutputTokens: 2048,
  },
};

/**
 * Cliente Gemini (NestJS Service)
 */
export const GeminiClientService = `
import { Injectable } from '@nestjs/common';
import { GoogleGenerativeAI } from '@google/generative-ai';

@Injectable()
export class GeminiClientService {
  private genAI: GoogleGenerativeAI;
  private model: any;

  constructor() {
    this.genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);
    this.model = this.genAI.getGenerativeModel({ 
      model: 'gemini-2.5-flash',
      generationConfig: {
        temperature: 0.7,
        topK: 40,
        topP: 0.95,
        maxOutputTokens: 2048,
      },
    });
  }

  async generateBlogPost(
    topic: string,
    keywords: string[],
    systemPrompt?: string,
  ): Promise<string> {
    const prompt = \`
\${systemPrompt || GeminiConfig.defaultSystemPrompt}

Tópico: \${topic}
Palavras-chave para incluir: \${keywords.join(', ')}

Escreva um post de blog completo em Markdown.
    \`;

    const result = await this.model.generateContent(prompt);
    const response = await result.response;
    return response.text();
  }

  async analyzeTrends(): Promise<string[]> {
    const prompt = \`
Analise as tendências atuais em:
1. Recuperação Tributária no Brasil
2. Cibersegurança Ofensiva

Liste 5 tópicos relevantes para criar posts de blog.
Retorne apenas a lista, um tópico por linha.
    \`;

    const result = await this.model.generateContent(prompt);
    const response = await result.response;
    const text = response.text();
    
    return text.split('\\n').filter(line => line.trim());
  }
}
`;

// ============================================================================
// 2. AUTO-BLOGGING (Cron Job)
// ============================================================================

/**
 * Cron job que roda diariamente para gerar posts automaticamente
 */
export const AutoBlogCron = `
import { Injectable } from '@nestjs/common';
import { Cron, CronExpression } from '@nestjs/schedule';
import { GeminiClientService } from '../gemini/gemini-client.service';
import { BlogService } from '../../blog/blog.service';

@Injectable()
export class AutoBlogCron {
  constructor(
    private geminiClient: GeminiClientService,
    private blogService: BlogService,
  ) {}

  /**
   * Executa todos os dias às 9h
   */
  @Cron('0 9 * * *')
  async generateDailyPost() {
    console.log('[AutoBlog] Iniciando geração de post diário...');

    try {
      // 1. Analisar trends
      const trends = await this.geminiClient.analyzeTrends();
      
      if (trends.length === 0) {
        console.log('[AutoBlog] Nenhum trend identificado.');
        return;
      }

      // 2. Selecionar tópico aleatório
      const topic = trends[Math.floor(Math.random() * trends.length)];
      console.log(\`[AutoBlog] Tópico selecionado: \${topic}\`);

      // 3. Definir keywords baseadas no tópico
      const keywords = this.extractKeywords(topic);

      // 4. Buscar system prompt customizado (se existir)
      const systemPrompt = await this.blogService.getSystemPrompt();

      // 5. Gerar conteúdo
      const content = await this.geminiClient.generateBlogPost(
        topic,
        keywords,
        systemPrompt,
      );

      // 6. Extrair título (primeira linha do markdown)
      const title = this.extractTitle(content);

      // 7. Gerar slug
      const slug = this.generateSlug(title);

      // 8. Gerar excerpt (primeiros 200 caracteres)
      const excerpt = this.extractExcerpt(content);

      // 9. Categorizar automaticamente
      const category = this.categorizeContent(content);

      // 10. Salvar como draft
      await this.blogService.createPost({
        title,
        slug,
        excerpt,
        content,
        category,
        tags: keywords,
        author: 'IA',
        status: 'draft', // Master Admin revisa antes de publicar
      });

      console.log(\`[AutoBlog] Post criado com sucesso: \${title}\`);

      // 11. Notificar Master Admin (opcional)
      // await this.notificationService.notifyNewDraft(title);

    } catch (error) {
      console.error('[AutoBlog] Erro ao gerar post:', error);
    }
  }

  private extractKeywords(topic: string): string[] {
    // Lógica simples de extração de keywords
    const commonWords = ['de', 'da', 'do', 'em', 'para', 'com', 'e', 'o', 'a'];
    return topic
      .toLowerCase()
      .split(' ')
      .filter(word => word.length > 3 && !commonWords.includes(word))
      .slice(0, 5);
  }

  private extractTitle(content: string): string {
    const lines = content.split('\\n');
    const titleLine = lines.find(line => line.startsWith('# '));
    return titleLine ? titleLine.replace('# ', '').trim() : 'Sem Título';
  }

  private generateSlug(title: string): string {
    return title
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\\u0300-\\u036f]/g, '') // Remove acentos
      .replace(/[^a-z0-9\\s-]/g, '')
      .replace(/\\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
  }

  private extractExcerpt(content: string): string {
    const plainText = content
      .replace(/^#.*$/gm, '') // Remove headers
      .replace(/\\*\\*(.+?)\\*\\*/g, '$1') // Remove bold
      .replace(/\\*(.+?)\\*/g, '$1') // Remove italic
      .trim();
    
    return plainText.substring(0, 200) + '...';
  }

  private categorizeContent(content: string): string {
    const lowerContent = content.toLowerCase();
    
    if (lowerContent.includes('tributário') || lowerContent.includes('fiscal')) {
      return 'tributario';
    }
    
    if (lowerContent.includes('pentest') || lowerContent.includes('segurança')) {
      return 'seguranca';
    }
    
    return 'tecnologia';
  }
}
`;

