# API Environment Variables
PORT=3001
MONGODB_URI=mongodb://localhost:27017/ultra_systems
FRONTEND_URL=http://localhost:3000

# JWT Secret
JWT_SECRET=ultra-systems-secret-key-2024

# News APIs
NEWS_API_KEY=your_newsapi_ai_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# OpenAI (para geração de conteúdo)
OPENAI_API_KEY=your_openai_api_key_here

# Email (opcional - para envio de relatórios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@ultrasystemsgroup.com.br
SMTP_PASS=your_app_password_here

# URLs
SITE_URL=https://ultrasystems.com.br
BLOG_URL=https://ultrasystems.com.br/blog
